{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "regions": [
    "fra1"
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "{server/assets/**,dist/**}",
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "portale-risultati-tt.it"
        }
      ],
      "destination": "https://portale-risultati-tt.it/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/push/check-ranking",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/push/check-tornei",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/push/check-campionati",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/push/check-matchday",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/videos/sync",
      "schedule": "0 6 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/regioni/:slug",
      "destination": "/regioni/:slug/index.html"
    },
    {
      "source": "/player/:id",
      "destination": "/api/index.js"
    },
    {
      "source": "/atleta/:id",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
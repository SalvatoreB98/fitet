# Supabase Credentials Template
# Inserisci queste variabili d'ambiente nella dashboard del tuo progetto su Vercel:
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Web Push (VAPID)
# Genera le chiavi con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:noreply@your-domain.it

# Segreto per proteggere l'endpoint cron /api/push/check-ranking
# Su Vercel viene inviato automaticamente come Authorization: Bearer <CRON_SECRET>
CRON_SECRET=una-stringa-casuale-lunga

# Google Gemini API (per pronostici testa a testa con IA)
# Ottieni la chiave gratuita su Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash
REDIS_PASSWORD=your-redis-pw
REDIS_URL=your-redis-Credentials
REDISHOST=your-redis-Credentials
REDISPASSWORD=your-redis-Credentials
REDISPORT=your-redis-Credentials
REDISUSER=your-redis-Credentials